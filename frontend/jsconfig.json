{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "components/*": [
                "./src/components/*"
            ],
            "pages/*": [
                "./src/pages/*"
            ],
            "utils/*": [
                "./src/utils/*"
            ],
            "styles/*": [
                "./src/styles/*"
            ]
        },
        "jsx": "react",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}